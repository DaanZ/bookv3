# Copy to deploy/deploy.env and fill in. deploy.env is gitignored — it names a host,
# not a secret, but the two are close enough that it is not worth the argument.

# Where the app answers. Must end in a slash, and must match the nginx location block.
PUBLIC_BASE=/books/

# The server. Anything ssh understands: a host, an alias from ~/.ssh/config, user@host.
DEPLOY_HOST=singularitynexus.nl
DEPLOY_USER=deploy

# Where the release lands. The service runs from here and the data directory lives
# inside it, so this path is the app's whole world on that machine.
DEPLOY_PATH=/srv/bookv3

# The systemd unit to restart after the files land. Empty to skip the restart, which is
# what you want the first time, before the unit exists.
DEPLOY_SERVICE=bookv3

# The port uvicorn binds on the server, behind nginx. Internal only — nothing outside
# the machine should reach it, and the nginx config binds it to 127.0.0.1.
DEPLOY_PORT=8001
