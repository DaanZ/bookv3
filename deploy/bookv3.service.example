# Copy to /etc/systemd/system/bookv3.service on the server, edit the paths and user,
# then:  sudo systemctl daemon-reload && sudo systemctl enable --now bookv3
#
# The keys live in /etc/bookv3/bookv3.env, NOT in the release directory. That file is
# root-owned, mode 600, and no deploy ever writes to it — so shipping a new version
# cannot clobber a key, and a release tarball carries none.
#
#   sudo mkdir -p /etc/bookv3
#   sudo install -m 600 /dev/null /etc/bookv3/bookv3.env
#   sudo nano /etc/bookv3/bookv3.env      # OPENROUTER_API_KEY=... HARDCOVER_API_KEY=...

[Unit]
Description=bookv3 reader
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/srv/bookv3
EnvironmentFile=/etc/bookv3/bookv3.env

# --root-path tells FastAPI it is mounted under /books, which is what nginx strips
# before proxying. Routes still match /api — root_path only affects the URLs the app
# generates for itself, which is why /docs and any redirect come out right.
ExecStart=/srv/bookv3/.venv/bin/uvicorn api.main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --root-path /books \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=3

# The app writes only inside its own directory: data/ for profiles and positions,
# books/ for summaries. Nothing else on the machine needs to be writable.
ProtectSystem=strict
ReadWritePaths=/srv/bookv3
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
