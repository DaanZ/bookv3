{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reader-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8001"
      ],
      "port": 8001,
      "autoPort": false
    },
    {
      "name": "reader-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "autoPort": true
    },
    {
      "name": "reader-api-8011",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8011"
      ],
      "port": 8011,
      "autoPort": false
    },
    {
      "name": "reader-web-8011",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "web",
      "env": {
        "API_PORT": "8011"
      },
      "autoPort": true
    }
  ]
}